-- ===== WriteExecute.Base.Memory =====
namespace WriteExecute

/-- A word-addressed memory update, keeping every other address unchanged. -/
@[expose] def write {α β : Type} [DecidableEq α]
    (m : α → β) (a : α) (v : β) : α → β :=
  fun x => if x = a then v else m x

@[simp] theorem read_write_same {α β : Type} [DecidableEq α]
    (m : α → β) (a : α) (v : β) : write m a v a = v := by
  simp [write]

@[simp] theorem read_write_other {α β : Type} [DecidableEq α]
    (m : α → β) (a x : α) (v : β) (h : x ≠ a) :
    write m a v x = m x := by
  simp [write, h]

@[simp] theorem write_back {α β : Type} [DecidableEq α]
    (m : α → β) (a : α) : write m a (m a) = m := by
  funext x
  by_cases h : x = a <;> simp [write, h]

@[simp] theorem write_overwrite {α β : Type} [DecidableEq α]
    (m : α → β) (a : α) (v w : β) :
    write (write m a v) a w = write m a w := by
  funext x
  by_cases h : x = a <;> simp [write, h]

end WriteExecute

-- ===== WriteExecute.Spec.Machine =====
namespace WriteExecute.WE

/-- Ideal word-level Write-Execute machine: unbounded integer addresses and values, no registers,
no stack, no data reads. The only state is the program counter and the memory. -/
structure State where
  pc : Int
  mem : Int → Int

/-- Instruction encodings: `[1, rel, val]` stores `val` at `pc + 3 + rel` (displacement from the next
instruction, as with x86-64 RIP-relative addressing); `[2, rel]` jumps to `pc + 2 + rel`; `[3]` halts. -/
inductive Instr where
  | mov (rel val : Int)
  | jmp (rel : Int)
  | hlt

inductive Status where
  | running
  | halted
  | faulted
  deriving DecidableEq

/-- Instruction fetch reads only the three words at `pc`. Any other opcode word is a fault. -/
@[expose] def decode (m : Int → Int) (pc : Int) : Option Instr :=
  if m pc = 1 then some (.mov (m (pc + 1)) (m (pc + 2)))
  else if m pc = 2 then some (.jmp (m (pc + 1)))
  else if m pc = 3 then some .hlt
  else none

@[expose] def step (s : State) : Status × State :=
  match decode s.mem s.pc with
  | some (.mov r v) => (.running, ⟨s.pc + 3, write s.mem (s.pc + 3 + r) v⟩)
  | some (.jmp r) => (.running, ⟨s.pc + 2 + r, s.mem⟩)
  | some .hlt => (.halted, s)
  | none => (.faulted, s)

/-- Run at most `n` steps, stopping at the first non-running status. -/
@[expose] def run : Nat → State → Status × State
  | 0, s => (.running, s)
  | n + 1, s =>
    match step s with
    | (.running, t) => run n t
    | r => r

@[expose] def Halts (s : State) : Prop := ∃ n t, run n s = (.halted, t)
@[expose] def Faults (s : State) : Prop := ∃ n t, run n s = (.faulted, t)
@[expose] def Diverges (s : State) : Prop := ∀ n, (run n s).1 = .running

/-- The complete effect of one step as a function of the fetch window `(pc, m pc, m (pc+1), m (pc+2))`:
status, next program counter, and at most one store. -/
@[expose] def effect (pc a b c : Int) : Status × Int × Option (Int × Int) :=
  if a = 1 then (.running, pc + 3, some (pc + 3 + b, c))
  else if a = 2 then (.running, pc + 2 + b, none)
  else if a = 3 then (.halted, pc, none)
  else (.faulted, pc, none)

end WriteExecute.WE

-- ===== WriteExecute.Spec.Confinement =====
namespace WriteExecute.WE

/-! C04 vocabulary. A run that only ever fetches inside a finite address list `A` can only read words
in `W = A ∪ (A+1) ∪ (A+2)`, so all written values come from the finite list `V = s₀(W)` and all written
addresses from the finite list `T = {a + 3 + r | a ∈ A, r ∈ V}`. -/

@[expose] def fetchWords (A : List Int) : List Int := A ++ A.map (· + 1) ++ A.map (· + 2)
@[expose] def valueList (A : List Int) (s0 : State) : List Int := (fetchWords A).map s0.mem
@[expose] def targetList (A : List Int) (s0 : State) : List Int :=
  A.flatMap fun a => (valueList A s0).map fun r => a + 3 + r
@[expose] def allValues (A : List Int) (s0 : State) : List Int :=
  valueList A s0 ++ (targetList A s0).map s0.mem

/-- Every state reached by a still-running prefix has its program counter in `A`. -/
@[expose] def Confined (A : List Int) (s0 : State) : Prop :=
  ∀ n s, run n s0 = (.running, s) → s.pc ∈ A

end WriteExecute.WE

-- ===== WriteExecute.Base.Turing =====
namespace WriteExecute.TM

/-- A standard finite-alphabet, finite-state, two-sided Turing machine.
Each transition writes one symbol, moves one place, and chooses a new state.
None means halt. The finite indices supply effective enumerations. -/
structure Machine (alphabet states : Nat) where
  blank : Fin alphabet
  start : Fin states
  transition : Fin states → Fin alphabet → Option (Fin alphabet × Bool × Fin states)

structure Configuration (alphabet states : Nat) where
  state : Fin states
  head : Int
  tape : Int → Fin alphabet

@[expose] def step {alphabet states : Nat} (machine : Machine alphabet states)
    (c : Configuration alphabet states) : Option (Configuration alphabet states) :=
  match machine.transition c.state (c.tape c.head) with
  | none => none
  | some (symbol, right, state) =>
    some { state := state
           head := if right then c.head + 1 else c.head - 1
           tape := write c.tape c.head symbol }

/-- A finite input is placed to the right of head zero; all other cells are blank. -/
@[expose] def initialConfiguration {alphabet states : Nat} (machine : Machine alphabet states)
    (input : List (Fin alphabet)) : Configuration alphabet states :=
  { state := machine.start
    head := 0
    tape := fun position => if position < 0 then machine.blank
            else (input[position.toNat]?).getD machine.blank }

@[expose] def run {alphabet states : Nat} (machine : Machine alphabet states) :
    Nat → Configuration alphabet states → Option (Configuration alphabet states)
  | 0, c => some c
  | n + 1, c => (step machine c).bind (run machine n)

/-- Halting is a missing transition reached after finitely many actual steps. -/
@[expose] def Halts {alphabet states : Nat} (machine : Machine alphabet states)
    (start : Configuration alphabet states) : Prop :=
  ∃ n finish, run machine n start = some finish ∧ step machine finish = none

/-- Infinite computation is defined through every finite prefix, not by
selecting a separate finite-memory hardware instance for each prefix. -/
@[expose] def Diverges {alphabet states : Nat} (machine : Machine alphabet states)
    (start : Configuration alphabet states) : Prop :=
  ∀ n, ∃ finish, run machine n start = some finish

end WriteExecute.TM

-- ===== WriteExecute.Spec.Universal =====
namespace WriteExecute.Universal

open WriteExecute.TM

/-! The construction. One tape cell is a block of `cellSize` words. Its first `2Q` words are one jump
per state `q` (`[2, d]` at offset `2q`); the displacement `d` of that jump records the cell's symbol
by pointing at the handler for `(q, symbol)`. A handler for a transition `(q,a) -> (a',right,q')` is
`Q` stores that rewrite every entry displacement of the current cell to symbol `a'`, followed by a
jump to the entry of state `q'` in the neighbouring cell. A missing transition is a halt. Handlers are
never written; only the entry displacements are. -/

@[expose] def handlerSize (Q : Nat) : Nat := 3 * Q + 2
@[expose] def cellSize (A Q : Nat) : Nat := 2 * Q + Q * A * handlerSize Q
/-- Offset of the handler for state `q` and symbol `sym` inside a cell. -/
@[expose] def handlerAt (A Q q sym : Nat) : Nat := 2 * Q + (q * A + sym) * handlerSize Q
/-- Displacement of state `q`'s entry jump (at offset `2q`) when the cell holds `sym`. -/
@[expose] def entryDisp (A Q q sym : Nat) : Int := (handlerAt A Q q sym : Int) - 2 * (q : Int) - 2

@[expose] def trans {A Q : Nat} (M : Machine A Q) (q sym : Nat) : Option (Fin A × Bool × Fin Q) :=
  if h : q < Q ∧ sym < A then M.transition ⟨q, h.1⟩ ⟨sym, h.2⟩ else none

/-- Word `off` of the handler for `(q, sym)`. -/
@[expose] def handlerWord {A Q : Nat} (M : Machine A Q) (q sym off : Nat) : Int :=
  match trans M q sym with
  | none => if off = 0 then 3 else 0
  | some (next, right, q') =>
    if off < 3 * Q then
      (if off % 3 = 0 then 1
       else if off % 3 = 1 then
         (2 * ((off / 3 : Nat) : Int) + 1) - ((handlerAt A Q q sym : Int) + 3 * ((off / 3 : Nat) : Int) + 3)
       else entryDisp A Q (off / 3) next.val)
    else if off = 3 * Q then 2
    else
      (if right then (cellSize A Q : Int) else -(cellSize A Q : Int)) + 2 * (q'.val : Int)
        - ((handlerAt A Q q sym : Int) + 3 * (Q : Int) + 2)

/-- Word `j` of a cell holding symbol `sym`. -/
@[expose] def cellWord {A Q : Nat} (M : Machine A Q) (sym j : Nat) : Int :=
  if j < 2 * Q then (if j % 2 = 0 then 2 else entryDisp A Q (j / 2) sym)
  else if j - 2 * Q < Q * A * handlerSize Q then
    handlerWord M ((j - 2 * Q) / handlerSize Q / A) ((j - 2 * Q) / handlerSize Q % A) ((j - 2 * Q) % handlerSize Q)
  else 0

/-- The memory image of a tape: cell `c` occupies addresses `c * cellSize .. c * cellSize + cellSize - 1`. -/
@[expose] def layout {A Q : Nat} (M : Machine A Q) (tape : Int → Fin A) : Int → Int :=
  fun a => cellWord M (tape (a / (cellSize A Q : Int))).val (a % (cellSize A Q : Int)).toNat

/-- A configuration's machine state: the program counter is at the entry of the current state in the
current cell. -/
@[expose] def encode {A Q : Nat} (M : Machine A Q) (cfg : Configuration A Q) : WE.State :=
  ⟨cfg.head * (cellSize A Q : Int) + 2 * (cfg.state.val : Int), layout M cfg.tape⟩

/-- The initial image for a finite input: the template everywhere, the input in cells `0 ..`. -/
@[expose] def initial {A Q : Nat} (M : Machine A Q) (input : List (Fin A)) : WE.State :=
  encode M (initialConfiguration M input)

/-- A finite image of `N` cells (indices `0 .. N-1`): the layout inside, the opcode `0` everywhere else. -/
@[expose] def bounded {A Q : Nat} (M : Machine A Q) (N : Nat) (tape : Int → Fin A) : Int → Int :=
  fun a => if 0 ≤ a / (cellSize A Q : Int) ∧ a / (cellSize A Q : Int) < (N : Int)
    then layout M tape a else 0

/-- Machine state for the finite image. -/
@[expose] def encodeB {A Q : Nat} (M : Machine A Q) (N : Nat) (cfg : Configuration A Q) : WE.State :=
  ⟨cfg.head * (cellSize A Q : Int) + 2 * (cfg.state.val : Int), bounded M N cfg.tape⟩

end WriteExecute.Universal

-- ===== WriteExecute.Spec.Arith =====
/-! Algorithm-level specifications of the Write-Execute arithmetic (writeexc.asm), over little-endian
base-256 digit lists. The asm itself is evidence-tied (native vectors), not proved: see D1 in the plan.
Table functions transcribe the MASM macro expressions literally. -/

namespace WriteExecute.Arith

@[expose] def ofBytes : List Nat → Nat
  | [] => 0
  | b :: bs => b + 256 * ofBytes bs

@[expose] def toBytes : Nat → Nat → List Nat
  | 0, _ => []
  | k + 1, x => x % 256 :: toBytes k (x / 256)

/-! 8-bit tables (writeexc.asm: DEFINENOT, DEFINENZ, DEFINESHLGEN, DEFINESHRGEN, DEFINEINC, DEFINEDEC,
DEFINEADD, DEFINESUB; XOR/OR/AND are the bitwise operators). -/

@[expose] def tNot (i : Nat) : Nat := i ^^^ 255
@[expose] def tNZ (i : Nat) : Nat := if i ≠ 0 then 1 else 0
@[expose] def tShlLo (o i : Nat) : Nat := (i <<< o) &&& 255
@[expose] def tShlHi (o i : Nat) : Nat := i >>> (8 - o)
@[expose] def tShrLo (o i : Nat) : Nat := (i <<< (8 - o)) &&& 255
@[expose] def tShrHi (o i : Nat) : Nat := i >>> o
@[expose] def tIncLo (i : Nat) : Nat := (i + 1) &&& 255
@[expose] def tIncHi (i : Nat) : Nat := (i + 1) >>> 8
@[expose] def tDecLo (i : Nat) : Nat := (i + 255) &&& 255
@[expose] def tDecBor (i : Nat) : Nat := if i = 0 then 1 else 0
@[expose] def tAddLo (a b : Nat) : Nat := (a + b) &&& 255
/-- The carry expression of DEFINEADD: `(Orig and 80h and Index and 80h or (not (Orig+Index)) and 80h
and ((Index and 80h) xor (Orig and 80h))) shr 7`. -/
@[expose] def tAddCry (a b : Nat) : Nat :=
  (((a &&& 0x80) &&& (b &&& 0x80)) |||
    ((((a + b) &&& 0x80) ^^^ 0x80) &&& ((b &&& 0x80) ^^^ (a &&& 0x80)))) >>> 7
@[expose] def tSubLo (a b : Nat) : Nat := (a + 256 - b) &&& 255
@[expose] def tSubBor (a b : Nat) : Nat := if a < b then 1 else 0

/-! Wide addition/subtraction (ADDBYTE/SUBBYTE): byte `i` first receives the carry of byte `i-1` by
`INC` (resp. `DEC`) on its first operand, then the byte table. The two carries are exclusive. -/

@[expose] def incIf (cin a : Nat) : Nat × Nat :=
  if cin = 1 then (tIncLo a, tIncHi a) else (a, 0)

@[expose] def decIf (bin a : Nat) : Nat × Nat :=
  if bin = 1 then (tDecLo a, tDecBor a) else (a, 0)

@[expose] def addDigits : List Nat → List Nat → Nat → List Nat × Nat
  | a :: as, b :: bs, cin =>
    let p := incIf cin a
    let r := addDigits as bs (tAddCry p.1 b + p.2)
    (tAddLo p.1 b :: r.1, r.2)
  | _, _, cin => ([], cin)

@[expose] def subDigits : List Nat → List Nat → Nat → List Nat × Nat
  | a :: as, b :: bs, bin =>
    let p := decIf bin a
    let r := subDigits as bs (tSubBor p.1 b + p.2)
    (tSubLo p.1 b :: r.1, r.2)
  | _, _, bin => ([], bin)

/-- `n`-byte wrapping addition / subtraction. -/
@[expose] def addN (n x y : Nat) : Nat := ofBytes (addDigits (toBytes n x) (toBytes n y) 0).1
@[expose] def subN (n x y : Nat) : Nat := ofBytes (subDigits (toBytes n x) (toBytes n y) 0).1

/-! Shifts (SHLBYTE/SHLCARRY, SHRBYTE/SHRCARRY): a whole-byte move by `c / 8` and a bit shift by
`c % 8` through the SHLGEN/SHRGEN tables, the carry between bytes combined with XOR. -/

@[expose] def shlPass (o : Nat) : Nat → List Nat → List Nat
  | _, [] => []
  | h, b :: bs => (tShlLo o b ^^^ h) :: shlPass o (tShlHi o b) bs

@[expose] def shrPass (o : Nat) : List Nat → List Nat
  | [] => []
  | [b] => [tShrHi o b]
  | b :: c :: bs => (tShrHi o b ^^^ tShrLo o c) :: shrPass o (c :: bs)

@[expose] def shlN (n x c : Nat) : Nat :=
  ofBytes (shlPass (c % 8) 0 ((List.replicate (c / 8) 0 ++ toBytes n x).take n))

@[expose] def shrN (n x c : Nat) : Nat :=
  ofBytes (shrPass (c % 8) ((toBytes n x).drop (c / 8) ++ List.replicate (c / 8) 0))

/-- XOR of `n`-byte words, byte by byte through the XOR table. -/
@[expose] def xorDigits : List Nat → List Nat → List Nat
  | a :: as, b :: bs => (a ^^^ b) :: xorDigits as bs
  | _, _ => []

@[expose] def xorN (n x y : Nat) : Nat := ofBytes (xorDigits (toBytes n x) (toBytes n y))

/-- 32 x 32 -> 64 shift-and-add multiplication (WriteExecMUL32; `doMul` in writeexec.c). -/
@[expose] def mulLoop : Nat → Nat → Nat → Nat → Nat
  | 0, _, _, acc => acc
  | k + 1, tx, y, acc =>
    mulLoop k (shlN 8 tx 1) (y / 2) (if y % 2 = 1 then addN 8 acc tx else acc)

@[expose] def mul32 (x y : Nat) : Nat := mulLoop 32 x y 0

/-- One iteration of `doDivision` (writeexec.c): 64-bit `quot`, 32-bit `rem`, with the remainder
overflow bit. -/
@[expose] def divStep (y : Nat) (s : Nat × Nat) : Nat × Nat :=
  let quot' := (s.1 * 2) % 2 ^ 64
  let carry := if quot' < s.1 then 1 else 0
  let remof := s.2 / 2 ^ 31 % 2 = 1
  let rem1 := (s.2 * 2 + carry) % 2 ^ 32
  if remof ∨ y ≤ rem1 then ((quot' + 1) % 2 ^ 64, (rem1 + 2 ^ 32 - y) % 2 ^ 32)
  else (quot', rem1)

@[expose] def divRun (y : Nat) : Nat → Nat × Nat → Nat × Nat
  | 0, s => s
  | k + 1, s => divRun y k (divStep y s)

/-- `(quotient mod 2^32, remainder)` of a 64-bit dividend by a 32-bit divisor. -/
@[expose] def doDivision (x y : Nat) : Nat × Nat :=
  let r := divRun y 64 (x, 0)
  (r.1 % 2 ^ 32, r.2)

/-- Right-to-left square and multiply (WriteExecMODEXP32). `init` is `1` in the asm (precondition
`m ≥ 2`) and `1 % m` in the corrected C reference (L02). -/
@[expose] def modexpLoop (m : Nat) : Nat → Nat → Nat → Nat → Nat
  | 0, r, _, _ => r
  | k + 1, r, b, e =>
    if e = 0 then r else modexpLoop m k (if e % 2 = 1 then r * b % m else r) (b * b % m) (e / 2)

@[expose] def modexpAsm (b e m : Nat) : Nat := modexpLoop m 32 1 (b % m) e
@[expose] def modexpRef (b e m : Nat) : Nat := modexpLoop m 32 (1 % m) (b % m) e

/-- Modular multiplications performed: one square per exponent bit and one multiply per set bit. -/
@[expose] def mulCount : Nat → Nat → Nat
  | 0, _ => 0
  | k + 1, e => if e = 0 then 0 else e % 2 + 1 + mulCount k (e / 2)

@[expose] def popcount : Nat → Nat → Nat
  | 0, _ => 0
  | k + 1, e => e % 2 + popcount k (e / 2)

/-- `mulmod` of spectreopt.c as published (the high half is divided, not reduced; see erratum L03). -/
@[expose] def mulmodLegacy (a b m : Nat) : Nat :=
  ((((a * b) / 2 ^ 32) / m) * 2 ^ 32 + (a * b) % 2 ^ 32) % m

/-- The corrected two-step reduction: reduce the high half, then the 64-bit value `hi * 2^32 + lo`. -/
@[expose] def mulmodFixed (a b m : Nat) : Nat :=
  ((((a * b) / 2 ^ 32) % m) * 2 ^ 32 + (a * b) % 2 ^ 32) % m

/-- The naive reference of the paper (`modexp` in spectreopt.c): one modular multiplication per unit
of the exponent. -/
@[expose] def naiveLoop (m b : Nat) : Nat → Nat → Nat
  | 0, c => c
  | k + 1, c => naiveLoop m b k (c * b % m)

@[expose] def modexpNaive (b e m : Nat) : Nat := if m = 1 then 0 else naiveLoop m b e 1

end WriteExecute.Arith

