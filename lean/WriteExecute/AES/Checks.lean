theorem te1_bytes : ∀ x, x < 256 → lbyte (teLit 1 x) 1 = mulc (tcoef 1 3) (sbox x) ∧ lbyte (teLit 1 x) 2 = mulc (tcoef 1 2) (sbox x) ∧ lbyte (teLit 1 x) 3 = mulc (tcoef 1 1) (sbox x) ∧ lbyte (teLit 1 x) 4 = mulc (tcoef 1 0) (sbox x) := by
  intro x hx
  by_cases h0 : x < 16
  · have := te1_bytes_c0 (x - 0) (by omega)
    rwa [show 0 + (x - 0) = x by omega] at this
  by_cases h1 : x < 32
  · have := te1_bytes_c1 (x - 16) (by omega)
    rwa [show 16 + (x - 16) = x by omega] at this
  by_cases h2 : x < 48
  · have := te1_bytes_c2 (x - 32) (by omega)
    rwa [show 32 + (x - 32) = x by omega] at this
  by_cases h3 : x < 64
  · have := te1_bytes_c3 (x - 48) (by omega)
    rwa [show 48 + (x - 48) = x by omega] at this
  by_cases h4 : x < 80
  · have := te1_bytes_c4 (x - 64) (by omega)
    rwa [show 64 + (x - 64) = x by omega] at this
  by_cases h5 : x < 96
  · have := te1_bytes_c5 (x - 80) (by omega)
    rwa [show 80 + (x - 80) = x by omega] at this
  by_cases h6 : x < 112
  · have := te1_bytes_c6 (x - 96) (by omega)
    rwa [show 96 + (x - 96) = x by omega] at this
  by_cases h7 : x < 128
  · have := te1_bytes_c7 (x - 112) (by omega)
    rwa [show 112 + (x - 112) = x by omega] at this
  by_cases h8 : x < 144
  · have := te1_bytes_c8 (x - 128) (by omega)
    rwa [show 128 + (x - 128) = x by omega] at this
  by_cases h9 : x < 160
  · have := te1_bytes_c9 (x - 144) (by omega)
    rwa [show 144 + (x - 144) = x by omega] at this
  by_cases h10 : x < 176
  · have := te1_bytes_c10 (x - 160) (by omega)
    rwa [show 160 + (x - 160) = x by omega] at this
  by_cases h11 : x < 192
  · have := te1_bytes_c11 (x - 176) (by omega)
    rwa [show 176 + (x - 176) = x by omega] at this
  by_cases h12 : x < 208
  · have := te1_bytes_c12 (x - 192) (by omega)
    rwa [show 192 + (x - 192) = x by omega] at this
  by_cases h13 : x < 224
  · have := te1_bytes_c13 (x - 208) (by omega)
    rwa [show 208 + (x - 208) = x by omega] at this
  by_cases h14 : x < 240
  · have := te1_bytes_c14 (x - 224) (by omega)
    rwa [show 224 + (x - 224) = x by omega] at this
  by_cases h15 : x < 256
  · have := te1_bytes_c15 (x - 240) (by omega)
    rwa [show 240 + (x - 240) = x by omega] at this
  omega

