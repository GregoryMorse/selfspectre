/-- Fig. 6: the layout of `WriteExecXOR` relative to `xorarg1`, and its position behind the `SHL5`/`SHL4` tables. -/
theorem x64c_xor_geometry :
    x64c_shlres5 = x64c_shlarg5 + 5 + 65536 ∧ x64c_shlret5 = x64c_shlres5 + 9 ∧ x64c_shlres4 + 14 ≤ x64c_shlarg5 ∧
    x64c_shlres5 + 14 ≤ x64c_xorarg1 ∧ x64c_xorarg2 = x64c_xorarg1 + 32 ∧ x64c_xorhead = x64c_xorarg1 + 83 ∧
    x64c_xorargshl1 = x64c_xorarg1 + 90 ∧ x64c_xorloop = x64c_xorarg1 + 109 ∧
    x64c_xorargshl2 = x64c_xorarg1 + 111 ∧ x64c_xorj = x64c_xorarg1 + 120 ∧
    x64c_xorres = x64c_xorarg1 + 125 + 2 ^ 21 ∧ x64c_xorret = x64c_xorres + 7 := by
  decide

/-- The 256 groups `xorarg1_i` sit `8192` bytes apart, the first one right behind `xorj`. -/
theorem x64c_xorarg1_offsets : ∀ i, i < 256 → x64c_xorarg1_tab.getD i 0 = x64c_xorarg1 + 125 + 8192 * i :=
  all1 (p := fun i => x64c_xorarg1_tab.getD i 0 = x64c_xorarg1 + 125 + 8192 * i) (by decide +kernel)

