theorem x64c_geometry :
    x64c_shlres4 = x64c_shlarg4 + 5 + 65536 ∧ x64c_shlret4 = x64c_shlres4 + 9 ∧
    x64c_notargshl = x64c_notarg + 32 ∧ x64c_notres = x64c_notarg + 37 + 4096 ∧
    x64c_notret = x64c_notres + 7 ∧ x64c_shlres4 + 14 ≤ x64c_notarg ∧
    x64c_nzargshl = x64c_nzarg + 32 ∧ x64c_nzres = x64c_nzarg + 37 + 4096 ∧ x64c_nzret = x64c_nzres + 7 := by
  decide

/-- Fig. 7: `carryNretval: jmp nocryN+8000h` is followed by the 2-byte `nocryN: jmp copy`, then `hascarryN`. -/
theorem x64c_carry_geometry :
    x64c_nocry1 = x64c_carry1retval + 5 ∧ x64c_hascarry1 = x64c_nocry1 + 2 ∧
    x64c_nocry2 = x64c_carry2retval + 5 ∧ x64c_hascarry2 = x64c_nocry2 + 2 ∧
    x64c_shlres = x64c_shlarg + 5 + 65536 ∧ x64c_shlret = x64c_shlres + 9 := by
  decide

/-- The NOT table entries sit at `base + 16 j` (uniform stride in the corrected source). -/
theorem x64c_notres_offsets : ∀ j, j < 256 → x64c_notres_tab.getD j 0 = (x64c_notarg + 37) + 16 * j :=
  all1 (p := fun j => x64c_notres_tab.getD j 0 = (x64c_notarg + 37) + 16 * j) (by decide +kernel)

